@page
@model LoginModel
@{
    ViewData["Title"] = "Logowanie";
}

<div class="row justify-content-center">
    <div class="col-12 col-sm-10 col-md-7 col-lg-5">
        <div class="card card-md">
            <div class="card-body">
                <h1 class="h2 text-center mb-4">Logowanie</h1>
                <form method="post" asp-route-returnUrl="@Model.ReturnUrl" novalidate>
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
                    <div class="mb-3">
                        <label class="form-label" asp-for="Input.Email">E-mail</label>
                        <input asp-for="Input.Email" class="form-control" autocomplete="username" placeholder="ty@example.com" />
                        <span asp-validation-for="Input.Email" class="invalid-feedback d-block"></span>
                    </div>
                    <div class="mb-3">
                        <label class="form-label" asp-for="Input.Password">Hasło</label>
                        <input asp-for="Input.Password" class="form-control" autocomplete="current-password" />
                        <span asp-validation-for="Input.Password" class="invalid-feedback d-block"></span>
                    </div>
                    <div class="mb-3">
                        <label class="form-check">
                            <input asp-for="Input.RememberMe" class="form-check-input" />
                            <span class="form-check-label">Zapamiętaj mnie</span>
                        </label>
                    </div>
                    <button id="login-submit" type="submit" class="btn btn-primary w-100">Zaloguj się</button>
                </form>
            </div>
        </div>
        <p class="text-center text-secondary mt-3">
            Nie masz konta? <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl">Zarejestruj się</a>
        </p>
    </div>
</div>
