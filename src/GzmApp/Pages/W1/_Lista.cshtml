@model GzmApp.Data.RecordList
@{
    var pl = System.Globalization.CultureInfo.GetCultureInfo("pl-PL");
}
<p id="licznik" class="count">Wyników: @Model.Count</p>
@if (Model.Items.Count == 0)
{
    <p class="list-empty">Brak gmin dla tych kryteriów.</p>
}
else
{
    <ul id="lista" class="rows">
        @foreach (var r in Model.Items)
        {
            var deficyt = r.AvailableBikes < r.RequiredBikes;
            var procent = r.RequiredBikes > 0 ? (int)Math.Round(r.AvailableBikes * 100.0 / r.RequiredBikes) : 100;
            var szerokosc = Math.Min(100, procent);
            <li class="row @(deficyt ? "is-bad" : "is-ok")" data-record-id="@r.RecordId" data-commune="@r.Commune" tabindex="0" role="button">
                <span class="row-no">@r.SourceRow</span>
                <span class="tytul">@r.Commune</span>
                <span class="status @(deficyt ? "is-bad" : "is-ok")">@(deficyt ? "Deficyt" : "OK")</span>
                <span class="bar @(deficyt ? "is-bad" : string.Empty)" title="Pokrycie @procent%"><span style="width:@(szerokosc)%"></span></span>
                <span class="row-nums"><span class="row-num" title="Dostępne">@r.AvailableBikes.ToString("N0", pl)</span><span class="row-sep">/</span><span class="row-num row-req" title="Wymagane">@r.RequiredBikes.ToString("N0", pl)</span></span>
                <span class="row-pct">@procent%</span>
            </li>
        }
    </ul>
}
