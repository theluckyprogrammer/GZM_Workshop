@model GzmApp.Data.RecordList
<p id="licznik" class="count">Wyników: @Model.Count</p>
@if (Model.Items.Count == 0)
{
    <p class="list-empty">Brak gmin dla tych kryteriów.</p>
}
else
{
    <ul id="lista" class="rows">
        @foreach (var r in Model.Items)
        {
            var deficyt = r.AvailableBikes < r.RequiredBikes;
            var procent = r.RequiredBikes > 0 ? Math.Min(100, (int)Math.Round(r.AvailableBikes * 100.0 / r.RequiredBikes)) : 100;
            <li class="row" data-record-id="@r.RecordId" data-commune="@r.Commune" tabindex="0" role="button">
                <span class="row-name"><span class="row-no">@r.SourceRow</span> <span class="tytul">@r.Commune</span></span>
                <span class="row-num">@r.AvailableBikes</span>
                <span class="row-num">@r.RequiredBikes</span>
                <span class="bar @(deficyt ? "is-bad" : string.Empty)" title="Pokrycie @procent%"><span style="width:@(procent)%"></span></span>
                <span class="status @(deficyt ? "is-bad" : "is-ok")">@(deficyt ? "Deficyt" : "OK")</span>
            </li>
        }
    </ul>
}
