@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@inject IConfiguration Configuration
@{
    var antiforgeryToken = Antiforgery.GetAndStoreTokens(Context).RequestToken;
}
<!DOCTYPE html>
<html lang="pl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] – GZM otwarte dane</title>
    <script>
        (function () {
            var saved = localStorage.getItem("motyw") || "light";
            document.documentElement.setAttribute("data-bs-theme", saved);
        })();
    </script>
    <link rel="stylesheet" href="~/lib/tabler/1.6.1/css/tabler.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <script src="~/lib/htmx/4.0.0/htmx.min.js"></script>
</head>
<body class="app-body" hx-headers:inherited='{"RequestVerificationToken":"@antiforgeryToken"}'>
    <aside class="sidebar">
        <nav class="side-menu" aria-label="Menu">
            <div class="side-title">Menu</div>
            <a asp-area="" asp-page="/Index">Strona główna</a>
            <a href="/#sekcja-gminy">Gminy</a>
            <a href="/#sekcja-info">Analiza AI</a>
            <a href="/#sekcja-mapa">Mapa</a>
        </nav>
        @await RenderSectionAsync("Sidebar", required: false)
        <div class="side-foot">
            <span id="data-attribution">@Configuration["DataAttribution"]</span>
        </div>
    </aside>

    <div class="main">
        <header class="topbar">
            <div class="topbar-inner">
                <a class="brand" asp-area="" asp-page="/Index">RowerStat <span>GZM · dane otwarte</span></a>
                @await RenderSectionAsync("Topbar", required: false)
                <div class="topbar-actions">
                    <button id="motyw" class="icon-btn" type="button" title="Zmień motyw jasny/ciemny">◐</button>
                    <partial name="_LoginPartial" />
                </div>
            </div>
        </header>

        <main class="workspace">
            @RenderBody()
        </main>
    </div>

    <script src="~/lib/tabler/1.6.1/js/tabler.min.js"></script>
    <script>
        (function () {
            var root = document.documentElement;
            document.getElementById("motyw").addEventListener("click", function () {
                var next = root.getAttribute("data-bs-theme") === "dark" ? "light" : "dark";
                root.setAttribute("data-bs-theme", next);
                localStorage.setItem("motyw", next);
            });
        })();
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
