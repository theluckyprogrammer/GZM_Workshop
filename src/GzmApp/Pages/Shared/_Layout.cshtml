@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@inject IConfiguration Configuration
@{
    var antiforgeryToken = Antiforgery.GetAndStoreTokens(Context).RequestToken;
}
<!DOCTYPE html>
<html lang="pl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] – GZM otwarte dane</title>
    <link rel="stylesheet" href="~/lib/tabler/1.6.1/css/tabler.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <script src="~/lib/htmx/4.0.0/htmx.min.js"></script>
</head>
<body class="d-flex flex-column min-vh-100" hx-headers:inherited='{"RequestVerificationToken":"@antiforgeryToken"}'>
    <header class="navbar navbar-expand-md d-print-none border-bottom">
        <div class="container-xl">
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#menu"
                    aria-controls="menu" aria-expanded="false" aria-label="Pokaż menu">
                <span class="navbar-toggler-icon"></span>
            </button>
            <a class="navbar-brand pe-md-3" asp-area="" asp-page="/Index">
                <span class="brand-mark me-2" aria-hidden="true">GZM</span> otwarte dane
            </a>
            <div class="collapse navbar-collapse" id="menu">
                <ul class="navbar-nav me-auto">
                    <li class="nav-item">
                        <a class="nav-link" asp-area="" asp-page="/Index">Strona główna</a>
                    </li>
                </ul>
                <partial name="_LoginPartial" />
            </div>
        </div>
    </header>

    <main role="main" class="page-body flex-grow-1 my-4">
        <div class="container-xl">
            @RenderBody()
        </div>
    </main>

    <footer class="footer footer-transparent d-print-none border-top py-3">
        <div class="container-xl text-secondary small" id="data-attribution">
            @Configuration["DataAttribution"]
        </div>
    </footer>

    <script src="~/lib/tabler/1.6.1/js/tabler.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
