@{
    var current = ViewContext.HttpContext.Request.Path.Value?.TrimEnd('/').ToUpperInvariant() ?? "";
    var variants = new (string Url, string Label)[]
    {
        ("/W1", "Propozycja 1 – szwajcarska siatka"),
        ("/W2", "Propozycja 2 – reportaż z danymi"),
        ("/W3", "Propozycja 3 – komunikacja miejska"),
        ("/W4", "Propozycja 4 – mapa na cały ekran"),
        ("/W5", "Propozycja 5 – serwis urzędowy"),
    };
}
<style>
    .propozycje {
        position: fixed; left: 50%; bottom: 16px; transform: translateX(-50%); z-index: 10000;
        display: flex; align-items: center; gap: 8px; padding: 6px 6px 6px 14px;
        background: #111; color: #fff; border-radius: 999px; box-shadow: 0 6px 24px rgba(0,0,0,.3);
        font: 500 13px/1.2 system-ui, "Segoe UI", sans-serif;
    }
    .propozycje label { margin: 0; white-space: nowrap; opacity: .75; }
    .propozycje select {
        appearance: auto; border: 0; border-radius: 999px; padding: 6px 10px;
        background: #fff; color: #111; font: inherit; cursor: pointer;
    }
</style>
<div class="propozycje">
    <label for="propozycja-wybor">Wygląd strony:</label>
    <select id="propozycja-wybor" onchange="location.href = this.value + location.search">
        @if (!variants.Any(v => v.Url == current))
        {
            <option value="/" selected>Wersja pierwotna</option>
        }
        @foreach (var v in variants)
        {
            <option value="@v.Url" selected="@(v.Url == current)">@v.Label</option>
        }
    </select>
</div>
