@model GzmApp.Pages.IndexModel
@{
    var pointsJson = Model.PunktyMapyJson;
    var start = Model.Podglad;
    var inv = System.Globalization.CultureInfo.InvariantCulture;
}
<div class="map-shell"
     id="mapa-root"
     data-points="@pointsJson"
     data-center-lat="@GzmApp.Data.GzmMap.CenterLat.ToString(inv)"
     data-center-lon="@GzmApp.Data.GzmMap.CenterLon.ToString(inv)"
     data-min-lat="@GzmApp.Data.GzmMap.MinLat.ToString(inv)"
     data-min-lon="@GzmApp.Data.GzmMap.MinLon.ToString(inv)"
     data-max-lat="@GzmApp.Data.GzmMap.MaxLat.ToString(inv)"
     data-max-lon="@GzmApp.Data.GzmMap.MaxLon.ToString(inv)"
     data-selected="@(start?.Commune ?? "")">
    <div id="map" class="map-canvas" role="img" aria-label="Mapa gmin GZM"></div>
    <div class="map-legend" aria-label="Legenda">
        <span class="legend-item"><i class="dot is-bad" aria-hidden="true"></i> Deficyt</span>
        <span class="legend-item"><i class="dot is-ok" aria-hidden="true"></i> Wystarcza</span>
        <span class="map-count">@Model.PunktyMapy.Count gmin</span>
    </div>
</div>
