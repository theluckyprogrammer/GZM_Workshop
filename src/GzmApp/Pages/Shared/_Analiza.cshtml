@model GzmApp.Ai.AiAnalysis
<article class="ai" data-ai>
    <div class="ai-head">
        <span class="ai-title">Podsumowanie</span>
        <span class="ai-model">@Model.Model</span>
    </div>
    <div class="ai-body ai-text">@Model.Text</div>
    <div class="ai-foot">
        Wygenerowano z @Model.RecordCount rekordów z bazy. Sprawdź liczby w danych.
        <details>
            <summary>Prompt</summary>
            <pre>@Model.Prompt</pre>
        </details>
    </div>
</article>
