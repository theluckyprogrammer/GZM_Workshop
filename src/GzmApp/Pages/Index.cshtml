@page
@model IndexModel
@{
    ViewData["Title"] = Model.Mapping.Dataset;
}

<h1 class="h3">@Model.Mapping.Dataset <small class="text-muted">(<span id="scenario-code">@Model.Mapping.Scenario</span>)</small></h1>

<section id="statystyka" class="card mb-3">
    <div class="card-body">
        <h2 class="h6 text-muted">@Model.Statistic.Description</h2>
        @if (Model.Statistic.Value is not null)
        {
            <p class="display-6 mb-0" data-stat-value>@Model.Statistic.Value</p>
        }
        else
        {
            <ol class="mb-0">
                @foreach (var g in Model.Statistic.Groups)
                {
                    <li data-stat>@g.Label: <strong>@g.Count</strong></li>
                }
            </ol>
        }
    </div>
</section>

<input type="search" name="q" class="form-control mb-3" placeholder="Szukaj…" aria-label="Szukaj"
       value="@Model.Results.Query"
       hx-get="?handler=Szukaj" hx-trigger="keyup changed delay:300ms" hx-target="#wyniki" />

<div id="wyniki">
    <partial name="_Lista" model="Model.Results" />
</div>
