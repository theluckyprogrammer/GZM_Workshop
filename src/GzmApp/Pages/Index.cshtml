@page
@model IndexModel
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@{
    Layout = null;
    var antiforgeryToken = Antiforgery.GetAndStoreTokens(HttpContext).RequestToken;
}
<!DOCTYPE html>
<html lang="pl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>RowerStat – wybierz wygląd</title>
    <style>
        * { box-sizing: border-box; }
        html, body { height: 100%; margin: 0; }
        body {
            font: 500 18px/1.4 system-ui, "Segoe UI", sans-serif;
            color: #111;
            background: #f4f4f2;
            display: grid;
            place-items: center;
            padding: 24px 24px 100px;
        }
        .chooser {
            text-align: center;
            max-width: 28rem;
        }
        .chooser h1 {
            margin: 0 0 12px;
            font-size: clamp(1.6rem, 4vw, 2.2rem);
            font-weight: 700;
            letter-spacing: -.02em;
        }
        .chooser p {
            margin: 0;
            color: #444;
            font-size: 1.05rem;
        }
        .hint {
            margin-top: 48px;
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 10px;
            color: #111;
        }
        .hint-text {
            font-size: .95rem;
            font-weight: 600;
        }
        .hint-arrow {
            width: 44px; height: 44px;
            border-radius: 50%;
            background: #ffe566;
            display: grid; place-items: center;
            font-size: 1.4rem;
            line-height: 1;
            box-shadow: 0 0 0 6px rgba(255, 214, 10, .35);
            animation: bounce 1.2s ease-in-out infinite;
        }
        @@keyframes bounce {
            0%, 100% { transform: translateY(0); }
            50% { transform: translateY(8px); }
        }
        #data-attribution { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0,0,0,0); }
    </style>
</head>
<body hx-headers:inherited='{"RequestVerificationToken":"@antiforgeryToken"}'>
    <partial name="_Propozycje" />
    <main class="chooser">
        <h1>RowerStat</h1>
        <p>Proszę wybrać wersję strony.</p>
        <div class="hint" aria-hidden="true">
            <span class="hint-text">tu na dole ↓</span>
            <span class="hint-arrow">↓</span>
        </div>
    </main>
    <span id="data-attribution"></span>
</body>
</html>
