// Kilo Code: reguły projektu i uprawnienia na warsztat (prompt 08).
// Składnia według https://kilo.ai/docs (Custom Rules: "instructions"; How Tools Work / Agent Permissions: "permission").
// W mapach wzorców wygrywa OSTATNIA pasująca reguła, dlatego "*" jest na początku.
{
  "$schema": "https://app.kilo.ai/config.json",
  // Model na warsztat (ustawienie prowadzącego): preset w OpenRouter.
  "provider": {
    "openrouter": {
      "models": {
        "z-ai/glm-5.3-flash": {
          "options": {
            "preset": "warsztaty-zspm"
          }
        }
      }
    }
  },
  "instructions": [".kilo/rules/*.md"],
  "permission": {
    "read": "allow",
    "glob": "allow",
    "grep": "allow",
    "edit": {
      "*": "allow",
      "**/*.csproj": "allow",
      "**/launch.json": "allow",
      "**/tasks.json": "allow",
      "**/launchSettings.json": "allow",
      "**/Program.cs": "allow",
      "src/GzmApp/Identity/**": "allow",
      "global.json": "allow",
      "kilo.jsonc": "allow",
      ".kilo/**": "allow",
      ".kilocode/**": "allow",
      "AGENTS.md": "allow",
      "data/**": "allow",
      "scenarios/**": "allow",
      "tests/**": "allow",
      "tools/**": "allow"
    },
    // Uczniowie budują projekt, uruchamiają testy kroków (dotnet test tests/GzmApp.Specs --filter ...)
    // i w kroku 0 tworzą portal skryptem tools/nowy-portal.ps1 (kopiowanie szkieletu + pobranie danych).
    "bash": {
      "*": "allow",
      "dotnet build*": "allow",
      "dotnet test*": "allow",
      "*nowy-portal.ps1*": "allow"
    },
    "webfetch": "allow",
    "websearch": "allow"
  }
}
