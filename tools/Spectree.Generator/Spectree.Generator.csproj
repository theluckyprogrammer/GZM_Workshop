<Project Sdk="Microsoft.NET.Sdk">

  <!-- Console tool (no NuGet packages): writes the test files of the pair's scenario as real *.cs files,
       so that the Testing panel navigates to normal code. Called on every build by tests/GzmApp.Specs
       (see the SpectreeSync target there). Usage (two arguments: spec folder, output folder)
       is documented at the top of Program.cs. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <InvariantGlobalization>true</InvariantGlobalization>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

</Project>
